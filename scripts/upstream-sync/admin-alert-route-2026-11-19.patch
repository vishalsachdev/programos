+interface ProviderRequest {
+  url: string;
+  idempotencyKey: string;
+  payload: {
+    from: string;
+    to: string[];
+    cc?: string[];
+    subject: string;
+    text: string;
+    reply_to: string;
+    headers: Record<string, string>;
