+  return {
+    cwd,
+    env: hostGitEnv(mode),
+    timeout,
+    maxBuffer: 64 * 1024 * 1024,
+    ...(root ? { uid: CHECKOUT_OWNER.uid, gid: CHECKOUT_OWNER.gid } : {}),
+  };
+}
