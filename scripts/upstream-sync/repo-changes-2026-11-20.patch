+      recordProviderResult('anthropic', { status: 500 });
+    vi.advanceTimersByTime(DEFAULT_FAILOVER_COOLDOWN_MS);
+    expect(selectProvider()).toBe('anthropic');
+    recordProviderResult('anthropic', { status: 429 });
