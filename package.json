{
  "name": "programos",
  "version": "1.2.53",
  "description": "A coordinator bot for a project or program team, and the knowledge base it keeps.",
  "keywords": [
    "coordinator",
    "email-bot",
    "knowledge-base",
    "team-assistant",
    "governance",
    "audit-log",
    "claude",
    "agent"
  ],
  "homepage": "https://programos.illinihunt.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishalsachdev/programos.git"
  },
  "bugs": {
    "url": "https://github.com/vishalsachdev/programos/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:gates": "node scripts/eval-gates.mjs",
    "eval:sensor": "tsx scripts/eval-sensor.ts",
    "eval:suite": "node scripts/eval-suite.mjs",
    "eval:report": "tsx scripts/eval-report.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.5.0",
    "htmlparser2": "^8.0.2",
    "mailparser": "^3.9.6",
    "mammoth": "^1.12.0",
    "nodemailer": "^10.6.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.35.5",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.35.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "smtp-server": "^3.21.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
