+      'ANTHROPIC_FOUNDRY_RESOURCE',
+    ])
+      expect(env.has(key)).toBe(false);
+
+    // The same token in the header, the URL and the registration.
+    const token = env.get('ANTHROPIC_CUSTOM_HEADERS')!.split(': ')[1];
