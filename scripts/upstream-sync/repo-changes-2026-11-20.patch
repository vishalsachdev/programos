+      .createHmac('sha256', SVIX_SECRET_BYTES)
+      .update(`${id}.${timestamp}.${body}`)
+      .digest('base64');
+  return post('/resend/webhook', body, {
+    'svix-id': id,
+    'svix-timestamp': timestamp,
+    'svix-signature': signature,
+  });
+}
