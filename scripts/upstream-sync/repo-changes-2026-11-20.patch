+  { isRoot: root }: { isRoot: boolean } = { isRoot: isRoot() },
+  cwd = getHostRepoPath(),
+  timeout = mode.credentialed
+    ? HOST_GIT_NETWORK_TIMEOUT_MS
+    : HOST_GIT_LOCAL_TIMEOUT_MS,
+): {
+  cwd: string;
+  uid?: number;
+  gid?: number;
+  env: NodeJS.ProcessEnv;
+  timeout: number;
+  maxBuffer: number;
