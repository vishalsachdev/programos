# ProgramOS instance settings.
#
# HOW SETTINGS ARE READ (two ways; this matters):
#   1. Keys in PART 1 are read from the file `.env` in the repo root.
#   2. Keys in PART 2 are read ONLY from the process environment. A line in
#      `.env` does nothing for them. Export them in the service definition
#      (systemd `Environment=`, pm2 `env`, or your shell before `node dist/index.js`).
# The parser does NOT strip inline comments. Put nothing after a value.
# Never commit `.env`.

# ============ PART 1: goes in `.env` ============

# REQUIRED. The bot's name. The code default is the upstream framework's
# default name, not "Coordinator".
ASSISTANT_NAME=Coordinator
# REQUIRED. The address the bot sends from and replies to.
SEND_FROM_EMAIL=
SEND_FROM_NAME=Coordinator
# The operator's address for host mail copies.
OPERATOR_CC_EMAIL=
TZ=America/Chicago

# REQUIRED. Shared secret for inbound mail webhooks.
WEBHOOK_SECRET=

# Model credentials for the agent (through the host's credential proxy).
# Use ONE of the first two. Leave unused lines out of `.env` entirely.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# Optional: an approved endpoint that serves Claude, for the AGENT only.
# The reply sensor does NOT use this setting; see SENSOR_PROVIDER below.
# A path prefix in this URL is kept: https://gateway.example.edu/claude
# receives requests at /claude/v1/messages.
# ANTHROPIC_BASE_URL=

# Model providers for the agent, in order. Values: anthropic, foundry.
# Absent = anthropic only. `anthropic,foundry` makes Claude on Microsoft
# Foundry (Azure) the backup; `foundry,anthropic` makes it the primary.
# A provider listed here without its settings stops the host at startup.
# WARNING: every provider listed receives your team's message text. Each
# Foundry deployment has a hosting option: "Hosted on Azure" (processed and
# stored on Azure) or "Hosted on Anthropic". Check it for each deployment
# before you tell anyone where data goes. See docs/illinois/model-foundry.md.
# MODEL_PROVIDERS=anthropic,foundry
# The Foundry resource name only, or the full base URL (one of the two).
# ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/anthropic
# The Foundry key. It stays on the host; the container gets a placeholder.
# ANTHROPIC_FOUNDRY_API_KEY=
# Header for the key when the caller sent none: api-key (default) or x-api-key.
# FOUNDRY_KEY_HEADER=api-key
# Deployment names (name each deployment by its model ID). On a Foundry run
# the first two replace NANOCLAW_AGENT_MODEL and NANOCLAW_GATE_MODEL; the
# other three pin the aliases opus, sonnet and haiku.
# FOUNDRY_AGENT_MODEL=
# FOUNDRY_GATE_MODEL=
# FOUNDRY_OPUS_MODEL=
# FOUNDRY_SONNET_MODEL=
# FOUNDRY_HAIKU_MODEL=
# Failures in a row before a provider is set aside (default 3), and for how
# long (default 1800000 = 30 minutes).
# MODEL_FAILOVER_THRESHOLD=
# MODEL_FAILOVER_COOLDOWN_MS=
# The reply sensor's destination: anthropic (default) or foundry. It does
# not fail over. With foundry, SENSOR_MODEL (PART 2) is a deployment name.
# This key is also read from the process environment.
# SENSOR_PROVIDER=

# Outbound mail provider (the reference deployment's provider).
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Telegram. Optional as a channel for the team, but operator alerts
# (delivery failures, routed-approval notices) are sent to the admin here.
# Without a token those alerts are not delivered.
# Create the chat sender allowlist first: if that file is missing, the chat
# trigger check allows every sender.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# Web chat (optional).
# WEBCHAT_SECRET=

# Optional features.
# GITHUB_PUSH_WEBHOOK_SECRET=
# EMAIL_OUTREACH_TASK_ID=
# DEAD_LETTER_ALERT_JID=
# OUTREACH_SUMMARY_JID=
# OUTBOUND_EMAIL_STAGGER_MS=

# ============ PART 2: export in the process environment ============

# REQUIRED. Absolute path to the program repo checkout on this host.
# PROGRAM_REPO=/srv/repos/your-program-repo
# Optional bare mirror for pinned host reads.
# PROGRAM_READ_MIRROR=
# REQUIRED if your program repo is not the placeholder one: a regular
# expression that the repo's git origin URL must match.
# PROGRAM_ORIGIN_PATTERN=^git@github\.com:your-org/your-program-repo(\.git)?$

# Keep the listener on loopback and put a reverse proxy in front.
# The code default is all interfaces.
# WEBHOOK_HOST=127.0.0.1
# WEBHOOK_PORT=3003
# CREDENTIAL_PROXY_PORT=3001

# The reply sensor calls a model API directly, with its own key, and sends
# reply text and knowledge-base excerpts. It ignores ANTHROPIC_BASE_URL and
# MODEL_PROVIDERS. Its destination is SENSOR_PROVIDER (PART 1): the public
# Anthropic API by default, or Foundry. Keep it off unless that destination
# is approved for your data.
# BEHAVIOUR_SENSOR_DISABLED=1
# SENSOR_MODEL=

# NANOCLAW_AGENT_MODEL=
# NANOCLAW_GATE_MODEL=
# NANOCLAW_AGENT_EFFORT=
# EMAIL_SENDER_DAILY_CAP=
# EMAIL_PERSON_SENDER_DAILY_CAP=
