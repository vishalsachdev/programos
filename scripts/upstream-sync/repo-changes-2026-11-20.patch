+    try {
+      loadModelProviderConfig();
+      throw new Error('expected a throw');
+    } catch (err) {
+      expect((err as Error).message).not.toContain('foundry-real-key');
+      expect((err as Error).message).not.toContain('sk-ant-real-key');
