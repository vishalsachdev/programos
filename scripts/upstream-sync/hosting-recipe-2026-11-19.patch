+      `CHECKOUT_OWNER_HOME must be an absolute path, got "${home}"`,
+    );
+  return {
+    uid: ownerId('CHECKOUT_OWNER_UID', env.CHECKOUT_OWNER_UID, 1000),
+    gid: ownerId('CHECKOUT_OWNER_GID', env.CHECKOUT_OWNER_GID, 1000),
+    home,
+  };
+}
