+    const cfg = loadModelProviderConfig();
+    expect(cfg.foundry!.baseUrl.host).toBe('other.example.edu');
+    expect(cfg.foundry!.keyHeader).toBe('x-api-key');
+    expect(cfg.foundry!.agentModel).toBe('agent-deploy');
