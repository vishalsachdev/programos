+    const claudeMd = read('CLAUDE.md');
+    const block = claudeMd.match(/```\n(### <short title>[\s\S]*?)```/);
+    expect(block).not.toBeNull();
+    const entry = block![1]
+      .replace('<short title>', 'Kickoff moved')
+      .replace('YYYY-MM-DD', '2030-02-03')
