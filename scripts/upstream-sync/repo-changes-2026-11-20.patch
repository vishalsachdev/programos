+    const chunks: Buffer[] = [];
+    req.on('data', (c) => chunks.push(c));
+    req.on('end', () => {
+      seen.push({
+        url: req.url!,
+        headers: { ...req.headers },
+        body: Buffer.concat(chunks).toString(),
+      });
+      res.writeHead(200, { 'content-type': 'application/json' });
